@model List<LaptopStore.Models.CartItem>
@using System.Linq
@{
	ViewBag.Title = "Giỏ hàng";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Giỏ hàng</h2>
@if (Model == null || Model.Count == 0)
{
	<p>Giỏ trống. @Html.ActionLink("Mua laptop", "Index", "Store")</p>
}
else
{
	<table class="table table-bordered">
		<thead>
			<tr>
				<th>Ảnh</th>
				<th>Tên</th>
				<th>Đơn giá</th>
				<th>SL</th>
				<th>Thành tiền</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td><img width="80" src="~/img/Item/@item.Picture" alt="" /></td>
					<td>@item.ItemName</td>
					<td>@string.Format("{0:N0}", item.UnitPrice)</td>
					<td>@item.Quantity</td>
					<td>@string.Format("{0:N0}", item.TotalPrice)</td>
				</tr>
			}
		</tbody>
	</table>
	<p><strong>Tổng:</strong> @string.Format("{0:N0} đ", Model.Sum(x => x.TotalPrice))</p>
	<h4>Đặt hàng</h4>
	using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
	{
		<div class="form-group">
			<label>Họ tên</label>
			<input name="customerName" class="form-control" required />
		</div>
		<div class="form-group">
			<label>Điện thoại</label>
			<input name="phone" class="form-control" required />
		</div>
		<div class="form-group">
			<label>Địa chỉ</label>
			<input name="address" class="form-control" required />
		</div>
		<button type="submit" class="btn btn-primary">Thanh toán / Đặt hàng</button>
	}
}
