
@using System.Linq
@using System.Web
@using System.Collections.Generic
@using ProTechTiveGear.Models
@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_LayoutHomePage.cshtml";
	var featuredItems = (ViewBag.FeaturedItems as IEnumerable<Item>) ?? Enumerable.Empty<Item>();
}

@model IEnumerable<ProTechTiveGear.Models.Item>

<style>
	.sp-grid { display: flex; flex-wrap: wrap; margin: 0 -10px; }
	.sp-grid > [class*="col-"] { padding: 0 10px; margin-bottom: 22px; display: flex; }
	.sp-card {
		background: #fff; border: 1px solid #eee; border-radius: 10px;
		box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 12px 14px 14px;
		width: 100%; display: flex; flex-direction: column; text-align: left;
	}
	.sp-img { position: relative; height: 170px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; overflow: hidden; background: #fafafa; border-radius: 8px; }
	.sp-img img { max-height: 160px; max-width: 100%; object-fit: contain; }
	.sp-off { position: absolute; top: 8px; right: 8px; width: 42px; height: 42px; border-radius: 50%; background: #e31c23; color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
	.sp-meta { display: flex; justify-content: space-between; align-items: center; font-size: 12px; margin-bottom: 6px; }
	.sp-stars { color: #d0d0d0; letter-spacing: 1px; }
	.sp-sku { color: #c0392b; font-weight: 600; }
	.sp-name { font-size: 14px; font-weight: 700; color: #222; line-height: 1.35; height: 38px; overflow: hidden; margin: 0 0 10px; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
	.sp-name:hover { color: #c0392b; text-decoration: none; }
	.sp-now { color: #e31c23; font-size: 20px; font-weight: 800; line-height: 1.2; margin: 0; }
	.sp-was { color: #9aa0a6; font-size: 13px; text-decoration: line-through; margin: 4px 0 12px; display: block; }
	.sp-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
	.sp-stock { color: #1aaa55; font-size: 13px; font-weight: 600; }
	.sp-stock.out { color: #c0392b; }
	.sp-bag { width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: inline-flex; align-items: center; justify-content: center; color: #333; text-decoration: none; }
	.sp-bag:hover { background: #e31c23; color: #fff; text-decoration: none; }
</style>
@Html.Partial("~/Views/Shared/_LaptopCardCss.cshtml")

@if (TempData["CartError"] != null)
{
	<script>alert(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["CartError"].ToString())));</script>
}

@{
	string qSearch = (ViewBag.Search as string) ?? (Request["search"] ?? "");
	bool isSearch = !string.IsNullOrWhiteSpace(qSearch);
}

@if (!isSearch)
{
<section class="welcome_bakery_area cake_feature_main" style="padding-top:0;padding-bottom:0;margin:0">
	@Html.Partial("~/Views/Shop/FeaturedBrand.cshtml", featuredItems)
</section>
}
<section class="welcome_bakery_area cake_feature_main" id="danh-sach-wrap" style="padding:16px 0 40px;margin:0">
	<div class="container">
		@{
			string hangSel = Request["hang"] ?? (ViewBag.Hang as string) ?? "";
			string sxSel = ((Request["sapxep"] ?? (ViewBag.SapXep as string) ?? "gia-asc") + "").Trim().ToLowerInvariant();
			string searchSel = qSearch;
			string sapXepTheo = "S\u1eafp x\u1ebfp theo";
			int totalCount = ViewBag.TotalCount != null ? Convert.ToInt32(ViewBag.TotalCount) : (Model != null ? Model.Count() : 0);
			string sortLabel =
				sxSel == "gia-desc" ? "Gi\u00e1 gi\u1ea3m d\u1ea7n" :
				sxSel == "moi" ? "S\u1ea3n ph\u1ea9m m\u1edbi nh\u1ea5t" :
				sxSel == "km" ? "Khuy\u1ebfn m\u00e3i t\u1ed1t nh\u1ea5t" :
				sxSel == "ban-chay" ? "S\u1ea3n ph\u1ea9m b\u00e1n ch\u1ea1y nh\u1ea5t" :
				"Gi\u00e1 t\u0103ng d\u1ea7n";

			Func<string, string> sortUrl = (code) =>
			{
				var rv = new System.Web.Routing.RouteValueDictionary();
				rv["sapxep"] = code;
				if (!string.IsNullOrEmpty(hangSel)) rv["hang"] = hangSel;
				if (!string.IsNullOrEmpty(searchSel)) rv["search"] = searchSel;
				return Url.Action("Index", "Shop", rv) + "#danh-sach";
			};
		}
		@if (isSearch)
		{
			<h2 style="font-size:22px;font-weight:800;margin:0 0 8px;color:#1a1a1a">@("K\u1ebft qu\u1ea3 t\u00ecm ki\u1ebfm")</h2>
			<p style="color:#667;margin:0 0 14px;font-size:13px">
				@("T\u1eeb kh\u00f3a"): <b style="color:#0b5cab">@searchSel</b>
				· @totalCount @("s\u1ea3n ph\u1ea9m")
				· <a href="@Url.Action("Index", "Shop")#danh-sach" style="color:#e67e22;font-weight:700">@("X\u00f3a b\u1ed9 l\u1ecdc")</a>
			</p>
		}
		else
		{
			<h2 style="font-size:22px;font-weight:800;margin:0 0 8px;color:#1a1a1a">@("T\u1ea5t c\u1ea3 laptop")</h2>
			<p style="color:#667;margin:0 0 14px;font-size:13px">
				@totalCount @("s\u1ea3n ph\u1ea9m") · @("\u0110ang s\u1eafp x\u1ebfp"): <b style="color:#e67e22">@sortLabel</b>
			</p>
		}
		<div class="sort-bar" id="danh-sach">
			<span class="lbl">@sapXepTheo</span>
			<a class="sort-btn @(sxSel == "km" ? "on" : "")" href="@sortUrl("km")" data-sort="km">@("Khuy\u1ebfn m\u00e3i t\u1ed1t nh\u1ea5t")</a>
			<a class="sort-btn @(sxSel == "gia-asc" || string.IsNullOrEmpty(sxSel) ? "on" : "")" href="@sortUrl("gia-asc")" data-sort="gia-asc"><i class="fa fa-line-chart"></i> @("Gi\u00e1 t\u0103ng d\u1ea7n")</a>
			<a class="sort-btn @(sxSel == "gia-desc" ? "on" : "")" href="@sortUrl("gia-desc")" data-sort="gia-desc"><i class="fa fa-area-chart"></i> @("Gi\u00e1 gi\u1ea3m d\u1ea7n")</a>
			<a class="sort-btn @(sxSel == "moi" ? "on" : "")" href="@sortUrl("moi")" data-sort="moi">@("S\u1ea3n ph\u1ea9m m\u1edbi nh\u1ea5t") <span class="sort-new">NEW</span></a>
			<a class="sort-btn @(sxSel == "ban-chay" ? "on" : "")" href="@sortUrl("ban-chay")" data-sort="ban-chay"><i class="fa fa-fire sort-hot"></i> @("S\u1ea3n ph\u1ea9m b\u00e1n ch\u1ea1y nh\u1ea5t")</a>
		</div>
		<div class="row" id="spSortGrid">
			@foreach (var item in Model)
			{
				decimal oldP = item.PurcharsePrice.HasValue && item.PurcharsePrice.Value > item.SellPrice
					? item.PurcharsePrice.Value : item.SellPrice;
				decimal offRate = oldP > item.SellPrice ? (oldP - item.SellPrice) / oldP : 0m;
				long sold = item.OrderDetails != null ? item.OrderDetails.Sum(o => o.Quantity) : 0;
				long ticks = item.DateImport.HasValue ? item.DateImport.Value.Ticks : 0;
				<div class="col-lg-3 col-md-4 col-6 sp-sort-item" style="margin-bottom:16px"
					 data-price="@item.SellPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
					 data-off="@offRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
					 data-sold="@sold"
					 data-date="@ticks">
					@Html.Partial("~/Views/Shared/_LaptopCard.cshtml", item)
				</div>
			}
		</div>
		@if (!Model.Any())
		{
			<div style="text-align:center;padding:48px 16px;background:#fff;border-radius:12px;border:1px solid #eee;margin-top:8px">
				<i class="fa fa-search" style="font-size:40px;color:#bbb"></i>
				<p style="margin:14px 0 8px;font-weight:700;color:#333">@("Kh\u00f4ng t\u00ecm th\u1ea5y s\u1ea3n ph\u1ea9m ph\u00f9 h\u1ee3p")</p>
				<p style="color:#777;margin:0 0 16px">@("Th\u1eed t\u1eeb kh\u00f3a kh\u00e1c, v\u00ed d\u1ee5: Lenovo, MacBook, Dell...")</p>
				<a href="@Url.Action("Index", "Shop")" style="display:inline-block;background:#0b5cab;color:#fff;padding:10px 18px;border-radius:8px;font-weight:700;text-decoration:none">@("Xem t\u1ea5t c\u1ea3 laptop")</a>
			</div>
		}
	</div>
</section>
@if (!isSearch)
{
	@Html.Action("Newdproducts", "Shop")
}
<script>
(function () {
	var bar = document.getElementById('danh-sach');
	var grid = document.getElementById('spSortGrid');
	if (!bar || !grid) return;
	bar.addEventListener('click', function (e) {
		var a = e.target;
		while (a && a !== bar && !(a.tagName === 'A' && a.getAttribute('data-sort'))) a = a.parentNode;
		if (!a || !a.getAttribute) return;
		var mode = a.getAttribute('data-sort');
		if (!mode) return;
		e.preventDefault();
		var items = Array.prototype.slice.call(grid.querySelectorAll('.sp-sort-item'));
		function num(el, key) { return parseFloat(el.getAttribute(key) || '0') || 0; }
		items.sort(function (x, y) {
			if (mode === 'gia-asc') return num(x, 'data-price') - num(y, 'data-price');
			if (mode === 'gia-desc') return num(y, 'data-price') - num(x, 'data-price');
			if (mode === 'km') return num(y, 'data-off') - num(x, 'data-off');
			if (mode === 'moi') return num(y, 'data-date') - num(x, 'data-date');
			if (mode === 'ban-chay') return num(y, 'data-sold') - num(x, 'data-sold');
			return 0;
		});
		items.forEach(function (el) { grid.appendChild(el); });
		var btns = bar.querySelectorAll('.sort-btn');
		for (var i = 0; i < btns.length; i++) btns[i].classList.toggle('on', btns[i].getAttribute('data-sort') === mode);
		if (window.history && history.replaceState) {
			history.replaceState(null, '', a.getAttribute('href'));
		}
		try { document.getElementById('danh-sach').scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (err) { }
	});
})();
</script>