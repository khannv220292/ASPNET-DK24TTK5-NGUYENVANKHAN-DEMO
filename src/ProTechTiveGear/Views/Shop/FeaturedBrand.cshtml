@model IEnumerable<ProTechTiveGear.Models.Item>
@using System.Linq
@using System.Collections.Generic
@using ProTechTiveGear.Models
@using ProTechTiveGear.Controllers
@{
	var slides = (ViewBag.FeaturedSlides as List<FeaturedSlideInfo>) ?? new List<FeaturedSlideInfo>();
	var newItems = (ViewBag.NewItems as IEnumerable<Item>) ?? Enumerable.Empty<Item>();
	string brand = (ViewBag.BrandName as string) ?? (slides.Count > 0 ? slides[0].BrandName : "Laptop");
	string theme = (ViewBag.Theme as string) ?? (slides.Count > 0 ? slides[0].Theme : "#0b5cab");
	string hero = (ViewBag.Hero as string) ?? "";
	string noiBat = "N\u1ed4I B\u1eacT";
	string titlePre = "S\u1ea3n ph\u1ea9m laptop ";
	string titlePost = " n\u1ed5i b\u1eadt";
	string sub = "Hi\u1ec7u n\u0103ng v\u01b0\u1ee3t tr\u1ed9i \u2013 Thi\u1ebft k\u1ebf hi\u1ec7n \u0111\u1ea1i \u2013 \u0110\u1ed9 b\u1ec1n chu\u1ea9n ";
	string rightTitle = "S\u1ea3n ph\u1ea9m m\u1edbi";

	// Fallback: 1 hang tu Model neu chua co slides
	if (slides.Count == 0 && Model != null && Model.Any())
	{
		slides.Add(new FeaturedSlideInfo
		{
			BrandName = brand,
			BrandId = ViewBag.BrandId != null ? Convert.ToInt64(ViewBag.BrandId) : 0,
			Theme = theme,
			Items = Model.Take(4).ToList()
		});
	}

	var rightPairs = new List<List<Item>>();
	var newPool = newItems.ToList();
	if (newPool.Count == 1)
	{
		rightPairs.Add(new List<Item> { newPool[0] });
	}
	else
	{
		for (int i = 0; i < newPool.Count; i += 2)
		{
			var pair = new List<Item> { newPool[i] };
			if (i + 1 < newPool.Count)
			{
				pair.Add(newPool[i + 1]);
			}
			else if (newPool.Count > 0)
			{
				pair.Add(newPool[0]);
			}
			rightPairs.Add(pair);
		}
	}
}
@Html.Partial("~/Views/Shared/_LaptopCardCss.cshtml")
<style>
	.feat-wrap { background:#fff; padding:12px 0 8px; --feat: #0b5cab; }
	.feat-badge { display:inline-flex; align-items:center; gap:6px; background:#eaf3ff; color:var(--feat); font-size:12px; font-weight:700; padding:5px 12px; border-radius:16px; }
	.feat-title { font-size:28px; font-weight:800; color:#1a1a1a; margin:10px 0 6px; }
	.feat-title b { color:var(--feat); font-size:34px; }
	.feat-sub { color:#5b6b7a; margin:0; }
	.feat-logo { font-size:42px; font-weight:900; color:var(--feat); letter-spacing:1px; line-height:1; }
	.feat-hero { max-height:110px; max-width:220px; object-fit:contain; }
	.feat-head { display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:10px; }
	.feat-trust { background:#eef6ff; border-radius:12px; padding:10px; display:flex; flex-wrap:wrap; margin-bottom:12px; }
	.feat-trust-item { flex:1 1 200px; display:flex; align-items:center; gap:10px; padding:8px 12px; }
	.feat-ico { width:38px; height:38px; border-radius:50%; background:var(--feat); color:#fff; display:flex; align-items:center; justify-content:center; }
	.feat-trust b { display:block; font-size:13px; color:#1a1a1a; }
	.feat-trust span { font-size:12px; color:#667; }
	.feat-dual { display:flex; gap:16px; flex-wrap:wrap; }
	.feat-pane { flex:1 1 320px; min-width:280px; border:1px solid #e6eef7; border-radius:14px; padding:14px; background:#fbfdff; box-shadow:0 2px 10px rgba(11,92,171,.05); }
	.feat-pane-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; gap:8px; }
	.feat-pane-head h3 { margin:0; font-size:16px; font-weight:800; color:#1a2744; }
	.feat-pane-tag { font-size:11px; font-weight:800; padding:3px 8px; border-radius:10px; color:#fff; }
	.feat-pane-tag.hot { background:var(--feat); }
	.feat-pane-tag.new { background:#1e88e5; }
	.feat-rotator { position:relative; }
	.feat-slide { display:none; }
	.feat-slide.on { display:block; }
	.feat-slide .row { margin-left:-8px; margin-right:-8px; }
	.feat-slide .row > [class*="col-"] { padding-left:8px; padding-right:8px; }
	.feat-dots { text-align:center; margin-top:12px; }
	.feat-dots span { display:inline-block; width:8px; height:8px; border-radius:50%; background:#cfd8e3; margin:0 3px; cursor:pointer; }
	.feat-dots span.on { background:var(--feat); }
	.feat-empty { text-align:center; color:#778; padding:40px 10px; font-size:13px; }
</style>
<section class="feat-wrap" id="featWrap" style="--feat:@(theme)">
	<div class="container">
		<div class="feat-head">
			<div>
				<div class="feat-badge">@noiBat</div>
				<h2 class="feat-title">@titlePre<b id="featBrandTitle">@brand</b>@titlePost</h2>
				<p class="feat-sub" id="featBrandSub">@(sub + brand)</p>
			</div>
			<div style="text-align:right">
				<div class="feat-logo" id="featBrandLogo">@brand</div>
				@if (!string.IsNullOrEmpty(hero))
				{
					<img class="feat-hero" id="featBrandHero" src="~/img/Item/@hero" alt="@brand" />
				}
			</div>
		</div>
		<div class="feat-trust">
			<div class="feat-trust-item"><div class="feat-ico"><i class="fa fa-shield"></i></div><div><b>Chính hãng 100%</b><span>Bảo hành toàn quốc</span></div></div>
			<div class="feat-trust-item"><div class="feat-ico"><i class="fa fa-percent"></i></div><div><b>Giá tốt mỗi ngày</b><span>Cập nhật ưu đãi</span></div></div>
			<div class="feat-trust-item"><div class="feat-ico"><i class="fa fa-truck"></i></div><div><b>Giao hàng toàn quốc</b><span>Nhanh chóng - An toàn</span></div></div>
			<div class="feat-trust-item"><div class="feat-ico"><i class="fa fa-credit-card"></i></div><div><b>Trả góp 0%</b><span>Thủ tục đơn giản</span></div></div>
		</div>

		<div class="feat-dual">
			<div class="feat-pane">
				<div class="feat-pane-head">
					<h3 id="featLeftTitle">Laptop @brand n\u1ed5i b\u1eadt</h3>
					<span class="feat-pane-tag hot">HOT</span>
				</div>
				<div class="feat-rotator" id="featLeftRotator">
					@if (slides.Count == 0)
					{
						<div class="feat-empty">Chưa có sản phẩm nổi bật.</div>
					}
					else
					{
						for (int s = 0; s < slides.Count; s++)
						{
							var slide = slides[s];
							var showItems = slide.Items.Take(2).ToList();
							string col = showItems.Count == 1 ? "col-sm-12" : "col-sm-6";
							string slideHero = showItems.Count > 0 ? ((showItems[0].Picture ?? "").Split('|')[0]) : "";
							<div class="feat-slide @(s == 0 ? "on" : "")" data-i="@s"
								 data-brand="@slide.BrandName" data-theme="@slide.Theme" data-hero="@slideHero">
								<div class="row">
									@foreach (var item in showItems)
									{
										<div class="@col" style="margin-bottom:12px">
											@Html.Partial("~/Views/Shared/_LaptopCard.cshtml", item)
										</div>
									}
								</div>
							</div>
						}
						<div class="feat-dots" id="featLeftDots">
							@for (int d = 0; d < slides.Count; d++)
							{
								<span class="@(d == 0 ? "on" : "")" data-i="@d" title="@slides[d].BrandName"></span>
							}
						</div>
					}
				</div>
			</div>

			<div class="feat-pane">
				<div class="feat-pane-head">
					<h3>@rightTitle</h3>
					<span class="feat-pane-tag new">NEW</span>
				</div>
				<div class="feat-rotator" id="featRightRotator">
					@if (rightPairs.Count == 0)
					{
						<div class="feat-empty">Chưa có sản phẩm mới.</div>
					}
					else
					{
						for (int s = 0; s < rightPairs.Count; s++)
						{
							var rightPair = rightPairs[s];
							string rightCol = rightPair.Count == 1 ? "col-sm-12" : "col-sm-6";
							<div class="feat-slide @(s == 0 ? "on" : "")" data-i="@s">
								<div class="row">
									@foreach (var item in rightPair)
									{
										<div class="@rightCol" style="margin-bottom:12px">
											@Html.Partial("~/Views/Shared/_LaptopCard.cshtml", item)
										</div>
									}
								</div>
							</div>
						}
						<div class="feat-dots" id="featRightDots">
							@for (int d = 0; d < rightPairs.Count; d++)
							{
								<span class="@(d == 0 ? "on" : "")" data-i="@d"></span>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>
<script>
(function () {
	function applyBrand(slide) {
		if (!slide) return;
		var brand = slide.getAttribute('data-brand') || 'Laptop';
		var theme = slide.getAttribute('data-theme') || '#0b5cab';
		var hero = slide.getAttribute('data-hero') || '';
		var wrap = document.getElementById('featWrap');
		if (wrap) wrap.style.setProperty('--feat', theme);
		var t = document.getElementById('featBrandTitle');
		var sub = document.getElementById('featBrandSub');
		var logo = document.getElementById('featBrandLogo');
		var left = document.getElementById('featLeftTitle');
		var img = document.getElementById('featBrandHero');
		if (t) t.textContent = brand;
		if (logo) logo.textContent = brand;
		if (left) left.textContent = 'Laptop ' + brand + ' nổi bật';
		if (sub) sub.textContent = 'Hiệu năng vượt trội – Thiết kế hiện đại – Độ bền chuẩn ' + brand;
		if (img) {
			if (hero) {
				img.style.display = '';
				var base = img.getAttribute('src') || '';
				var slash = base.lastIndexOf('/');
				img.src = (slash >= 0 ? base.substring(0, slash + 1) : '/img/Item/') + hero;
			} else {
				img.style.display = 'none';
			}
		}
	}
	function setup(rotatorId, dotsId, ms, onChange) {
		var root = document.getElementById(rotatorId);
		if (!root) return;
		var slides = root.querySelectorAll('.feat-slide');
		var dots = (document.getElementById(dotsId) || { querySelectorAll: function () { return []; } }).querySelectorAll('span');
		if (slides.length === 0) return;
		var i = 0;
		function go(n) {
			i = (n + slides.length) % slides.length;
			for (var x = 0; x < slides.length; x++) {
				slides[x].classList.toggle('on', x === i);
				if (dots[x]) dots[x].classList.toggle('on', x === i);
			}
			if (onChange) onChange(slides[i]);
		}
		for (var d = 0; d < dots.length; d++) {
			(function (idx) { dots[idx].onclick = function () { go(idx); }; })(d);
		}
		if (slides.length > 1) {
			setInterval(function () { go(i + 1); }, ms);
		}
		if (onChange) onChange(slides[0]);
	}
	setup('featLeftRotator', 'featLeftDots', 5000, applyBrand);
	setup('featRightRotator', 'featRightDots', 6500, null);
})();
</script>
