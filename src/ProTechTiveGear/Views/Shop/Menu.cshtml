@model IEnumerable<ProTechTiveGear.Models.Menu>
@using ProTechTiveGear.Models;
@{

	Customer acc = (Customer)Session["usr"];
	string username = "";
	if (Request.Cookies["usr"] != null)
	{
		username = Request.Cookies["usr"].Value;

	}

}

<div class="collapse navbar-collapse" id="navbarSupportedContent">

    <ul class="navbar-nav">
        <li class="dropdown submenu">
            <a class="dropdown-toggle" href="@Url.Action("Index","Shop")" role="button" aria-haspopup="true" aria-expanded="false">Trang chủ</a>

        </li>
        @foreach (var item in Model)
        {
			if (item.Name == null) { continue; }
			var n = item.Name.Trim();
			if (n.Equals("App", StringComparison.OrdinalIgnoreCase)
				|| n.Equals("LG", StringComparison.OrdinalIgnoreCase)
				|| n.Equals("Phụ kiện", StringComparison.OrdinalIgnoreCase)
				|| (n.StartsWith("Ph") && n != "HP"))
			{
				continue;
			}
            <li class="dropdown submenu">
                <a class="dropdown-toggle" href="@Url.Action("ProductbyMenu","Shop", new { id = item.ID })" role="button" aria-haspopup="true" aria-expanded="false">@item.Name</a>
                <ul class="dropdown-menu">
                    @Html.Action("ItemMenuType", "Shop", new { id = item.ID })
                    @Html.Action("Brandtype", "Shop", new { id = item.ID })

                </ul>
            </li>






        }
       @* <li class="dropdown submenu">
            <a class="dropdown-toggle" href="@Url.Action("Blog","Shop")" role="button" aria-haspopup="true" aria-expanded="false">Tin Tức</a>

        </li>*@
        @* Liên hệ + tìm kiếm đã chuyển lên header xanh *@

    </ul>

</div>
