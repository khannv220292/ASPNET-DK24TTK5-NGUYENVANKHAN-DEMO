@model ProTechTiveGear.Models.ItemType
@using ProTechTiveGear.Models
@using System.Linq
@using System.Collections.Generic
@{
    var gdb = new ProTechTiveGearEntities();
    string chonHang = "-- Ch\u1ecdn h\u00e3ng --";
    string lblDong = "D\u00f2ng s\u1ea3n ph\u1ea9m";
    string lblHang = "H\u00e3ng";
    var laptopBrands = new[] { "ASUS", "Acer", "Apple", "Dell", "Gigabyte", "HP", "Lenovo", "MSI" };

    foreach (var n in laptopBrands)
    {
        if (!gdb.Menus.Any(m => m.Name == n))
        {
            gdb.Menus.Add(new Menu { Name = n });
        }
    }
    gdb.SaveChanges();

    long? selectedId = Model != null ? Model.MenuID : null;
    var items = new List<SelectListItem>();
    items.Add(new SelectListItem { Text = chonHang, Value = "", Selected = selectedId == null });
    foreach (var n in laptopBrands)
    {
        var m = gdb.Menus.First(x => x.Name == n);
        var label = n == "Apple" ? "Laptop Apple (MacBook)" : ("Laptop " + n);
        items.Add(new SelectListItem { Text = label, Value = m.ID.ToString(), Selected = selectedId == m.ID });
    }
}

<div class="alert alert-info" style="max-width:720px">
    <b>Hang</b> = thuong hieu laptop. <b>Dong san pham</b> = ROG, TUF, Zenbook, ThinkPad...
</div>

<div class="form-group">
    <h5 class="control-label col-md-2">@lblDong</h5>
    <div class="col-md-10">
        @Html.EditorFor(model => model.TypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "VD: ROG, TUF, Zenbook..." } })
        @Html.ValidationMessageFor(model => model.TypeName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <h5 class="control-label col-md-2">@lblHang</h5>
    <div class="col-md-10">
        @Html.DropDownList("MenuID", items, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.MenuID, "", new { @class = "text-danger" })
    </div>
</div>
