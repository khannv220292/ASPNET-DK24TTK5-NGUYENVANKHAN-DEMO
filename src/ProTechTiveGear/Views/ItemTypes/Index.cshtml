@model IEnumerable<ProTechTiveGear.Models.ItemType>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Loại Sản Phẩm</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-success btn-sm" })
</p>
<table class="table">
    <tr>
        <th>Dòng sản phẩm</th>
        <th>Hãng</th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TypeName)
        </td>
        <td>
            @(item.Menu != null ? item.Menu.Name : "")
        </td>
        <td>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = item.ID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
        </td>
    </tr>
}

</table>
