@using ProTechTiveGear.Models
@model List<CartEntity>
@{
	ViewBag.Title = "Giỏ hàng";
	Layout = "~/Views/Shared/_LayoutHomePage.cshtml";
	ViewBag.HideBanner = true;
}
<style>
	.ck-cart { padding: 28px 0 48px; background: #f5f6f8; min-height: 50vh; }
	.ck-cart h2 { font-size: 22px; font-weight: 800; margin: 0 0 18px; color: #222; }
	.ck-table { width: 100%; background: #fff; border-collapse: collapse; border: 1px solid #ddd; }
	.ck-table thead th {
		background: #00cfff;
		color: #fff;
		font-weight: 700;
		padding: 12px 10px;
		text-align: left;
		border: 1px solid #00b8e6;
		white-space: nowrap;
	}
	.ck-table tbody td {
		padding: 12px 10px;
		border: 1px solid #ddd;
		vertical-align: middle;
		background: #fff;
		color: #222;
	}
	.ck-table img { max-height: 72px; max-width: 100px; object-fit: contain; display: block; }
	.ck-qty {
		width: 72px;
		height: 34px;
		border: 1px solid #ccc;
		border-radius: 4px;
		padding: 4px 8px;
		text-align: center;
	}
	.ck-link { color: #1976d2; font-weight: 600; text-decoration: none; }
	.ck-link:hover { text-decoration: underline; color: #0d47a1; }
	.ck-btn-pink {
		display: inline-block;
		background: #f48fb1;
		color: #fff !important;
		border: 1px solid #333;
		border-radius: 4px;
		padding: 7px 14px;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		text-decoration: none !important;
		line-height: 1.2;
	}
	.ck-btn-pink:hover { background: #ec407a; color: #fff !important; }
	.ck-btn-clear { margin-top: 14px; float: right; border: none; }
	.ck-summary {
		clear: both;
		margin-top: 28px;
		background: #fff;
		border: 1px solid #e0e0e0;
		border-radius: 8px;
		overflow: hidden;
		max-width: 380px;
		margin-left: auto;
	}
	.ck-summary-head { background: #00cfff; color: #fff; padding: 12px 16px; font-weight: 800; }
	.ck-summary-body { padding: 14px 16px; }
	.ck-summary-body p { display: flex; justify-content: space-between; margin: 0 0 10px; font-size: 15px; }
	.ck-summary-body .total { font-size: 18px; font-weight: 800; color: #e53935; margin-bottom: 16px; }
	.ck-btn-checkout {
		display: block;
		text-align: center;
		background: #0077dd;
		color: #fff !important;
		padding: 12px;
		border-radius: 6px;
		font-weight: 800;
		text-decoration: none !important;
	}
	.ck-btn-checkout:hover { background: #0060b3; color: #fff !important; }
	.ck-empty {
		text-align: center;
		padding: 56px 20px;
		background: #fff;
		border-radius: 10px;
		box-shadow: 0 2px 10px rgba(0,0,0,.05);
	}
</style>

<section class="ck-cart">
	<div class="container">
		<h2><i class="fa fa-shopping-cart"></i> Giỏ hàng</h2>

		@if (Model == null || Model.Count == 0)
		{
			<div class="ck-empty">
				<i class="fa fa-shopping-cart" style="font-size:48px;color:#bbb"></i>
				<h3 style="margin:16px 0 8px">Giỏ hàng trống</h3>
				<p style="color:#666;margin-bottom:20px">Bạn chưa thêm laptop nào. Hãy chọn sản phẩm rồi bấm &quot;Thêm vào giỏ&quot;.</p>
				<a class="ck-btn-checkout" href="@Url.Action("Index", "AuraStore")" style="display:inline-block;padding:10px 22px">Tiếp tục mua sắm</a>
			</div>
		}
		else
		{
			<div class="table-responsive">
				<table class="ck-table">
					<thead>
						<tr>
							<th>Ảnh</th>
							<th>Sản phẩm</th>
							<th>Giá</th>
							<th>Số lượng</th>
							<th>Tổng tiền</th>
							<th></th>
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>
									<img src="~/img/Item/@((item.Picture ?? "").Split('|')[0])" alt="@item.Name" />
								</td>
								@using (Html.BeginForm("EditCart", "Cart", new { id = item.IdItem }))
								{
									<td>@item.Name</td>
									<td>@string.Format("{0:#,##0}", item.Prices)</td>
									<td>
										<input class="ck-qty" type="number" name="txtSoluong" min="1" max="99" value="@item.Quantity" />
									</td>
									<td>@string.Format("{0:#,##0}", item.TotalPrices)</td>
									<td><a class="ck-link" href="@Url.Action("Detail", "AuraStore", new { id = item.IdItem })">Chi tiết</a></td>
									<td>@Html.ActionLink("Xóa", "DeleteCart", "Cart", new { id = item.IdItem }, new { @class = "ck-link" })</td>
									<td><button type="submit" class="ck-btn-pink">Cập nhật</button></td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>

			<a class="ck-btn-pink ck-btn-clear" href="@Url.Action("DeleteAll", "Cart")">Xóa tất cả</a>

			<div class="ck-summary">
				<div class="ck-summary-head">Đơn hàng</div>
				<div class="ck-summary-body">
					<p><span>Số lượng</span><b>@ViewBag.TotalQuantity</b></p>
					<p class="total"><span>Tổng tiền</span><span>@string.Format("{0:#,##0}đ", ViewBag.ToTalPrice)</span></p>
					<a class="ck-btn-checkout" href="@Url.Action("Order", "Cart")">Thanh toán</a>
				</div>
			</div>
		}
	</div>
</section>
