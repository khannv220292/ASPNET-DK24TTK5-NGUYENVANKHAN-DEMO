@model IEnumerable<LaptopStore.Models.StoreItem>
@{
    ViewBag.Title = "Cửa hàng Laptop KHANNVSHOP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="margin-top: 10px;">
    <div class="well p-3 mb-4" style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px;">
        @using (Html.BeginForm("Index", "Store", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group" style="margin-right: 10px;">
                <input type="text" name="search" class="form-control" style="width: 360px;"
                       placeholder="Nhập tên laptop cần tìm (VD: HP, Dell, ASUS...)" value="@ViewBag.CurrentSearch" />
            </div>
            <button type="submit" class="btn btn-primary" style="font-weight: 500;">Tìm kiếm tương đối</button>
            <a href="@Url.Action("Index", "Store")" class="btn btn-secondary ml-2">Tất cả sản phẩm</a>
        }
    </div>

    <h3 style="margin-bottom: 20px; font-weight: bold; border-left: 4px solid #337ab7; padding-left: 10px;">
        DANH SÁCH LAPTOP NỔI BẬT
    </h3>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    Không tìm thấy sản phẩm laptop nào phù hợp với từ khóa!
                </div>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                var fileName = string.IsNullOrWhiteSpace(item.Picture) ? "" : System.IO.Path.GetFileName(item.Picture.Replace("\\", "/"));
                var imgSrc = string.IsNullOrEmpty(fileName)
                    ? "https://placehold.co/300x200?text=Laptop"
                    : Url.Content("~/img/Item/" + fileName);

                <div class="col-12 col-sm-6 col-md-4 col-lg-3" style="margin-bottom: 30px;">
                    <div class="card h-100" style="border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                        <div class="card-body d-flex flex-column">
                            <div style="height: 190px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 10px;">
                                <img src="@imgSrc" alt="@item.Name"
                                     style="max-height: 180px; max-width: 100%; object-fit: contain;"
                                     onerror="this.onerror=null;this.src='https://placehold.co/300x200?text=Laptop';" />
                            </div>
                            <h4 style="font-size: 15px; font-weight: bold; line-height: 1.4; min-height: 65px; overflow: hidden;" title="@item.Name">
                                @item.Name
                            </h4>
                            <p class="text-danger mb-1" style="font-size: 18px; font-weight: bold;">
                                @string.Format("{0:#,##0} VNĐ", item.SellPrice)
                            </p>
                            <p style="font-size: 13px; color: #666;">
                                Số lượng tồn: <span class="badge badge-info">@item.Quantity</span>
                            </p>
                            <div class="mt-auto">
                                <a href="@Url.Action("Details", "Store", new { id = item.ID })" class="btn btn-info btn-sm">Chi tiết</a>
                                <a href="@Url.Action("AddToCart", "Cart", new { id = item.ID })" class="btn btn-success btn-sm">Thêm giỏ hàng</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
