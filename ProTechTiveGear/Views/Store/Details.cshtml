@model LaptopStore.Models.StoreItem
@{
	ViewBag.Title = Model.Name;
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
	<div class="col-md-5">
		<img class="img-fluid border" src="~/img/Item/@Model.Picture" alt="@Model.Name" />
	</div>
	<div class="col-md-7">
		<h2>@Model.Name</h2>
		<p class="h4 text-danger">@string.Format("{0:N0} đ", Model.SellPrice)</p>
		<p>Kho: @Model.Quantity</p>
		<p>@Model.Describe</p>
		<p>
			<a class="btn btn-success" href="@Url.Action("AddToCart", "Cart", new { id = Model.ID })">Thêm vào giỏ</a>
			@Html.ActionLink("Quay lại", "Index", "Store", null, new { @class = "btn btn-link" })
		</p>
	</div>
</div>
