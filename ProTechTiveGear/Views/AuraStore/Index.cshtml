
@using System.Linq
@using System.Web
@using ProTechTiveGear.Models
@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_LayoutHomePage.cshtml";
}

@model IEnumerable<ProTechTiveGear.Models.Item>

<style>
	.sp-grid { display: flex; flex-wrap: wrap; margin: 0 -10px; }
	.sp-grid > [class*="col-"] { padding: 0 10px; margin-bottom: 22px; display: flex; }
	.sp-card {
		background: #fff; border: 1px solid #eee; border-radius: 10px;
		box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 12px 14px 14px;
		width: 100%; display: flex; flex-direction: column; text-align: left;
	}
	.sp-img { position: relative; height: 170px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; overflow: hidden; background: #fafafa; border-radius: 8px; }
	.sp-img img { max-height: 160px; max-width: 100%; object-fit: contain; }
	.sp-off { position: absolute; top: 8px; right: 8px; width: 42px; height: 42px; border-radius: 50%; background: #e31c23; color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
	.sp-meta { display: flex; justify-content: space-between; align-items: center; font-size: 12px; margin-bottom: 6px; }
	.sp-stars { color: #d0d0d0; letter-spacing: 1px; }
	.sp-sku { color: #c0392b; font-weight: 600; }
	.sp-name { font-size: 14px; font-weight: 700; color: #222; line-height: 1.35; height: 38px; overflow: hidden; margin: 0 0 10px; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
	.sp-name:hover { color: #c0392b; text-decoration: none; }
	.sp-now { color: #e31c23; font-size: 20px; font-weight: 800; line-height: 1.2; margin: 0; }
	.sp-was { color: #9aa0a6; font-size: 13px; text-decoration: line-through; margin: 4px 0 12px; display: block; }
	.sp-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
	.sp-stock { color: #1aaa55; font-size: 13px; font-weight: 600; }
	.sp-stock.out { color: #c0392b; }
	.sp-bag { width: 36px; height: 36px; border-radius: 50%; background: #f0f0f0; display: inline-flex; align-items: center; justify-content: center; color: #333; text-decoration: none; }
	.sp-bag:hover { background: #e31c23; color: #fff; text-decoration: none; }
</style>
@Html.Partial("~/Views/Shared/_LaptopCardCss.cshtml")

<section class="welcome_bakery_area cake_feature_main" style="padding-top:0">
	@Html.Action("FeaturedBrand", "AuraStore")
</section>
<section class="welcome_bakery_area cake_feature_main p_100">
	<div class="container">
		@{
			string hangSel = Request["hang"] ?? (ViewBag.Hang as string) ?? "";
			string sxSel = Request["sapxep"] ?? (ViewBag.SapXep as string) ?? "gia-asc";
			string sapXepTheo = "S\u1eafp x\u1ebfp theo";
			string extra = "";
			if (!string.IsNullOrEmpty(Request.QueryString["search"]))
			{
				extra += "&search=" + HttpUtility.UrlEncode(Request.QueryString["search"]);
			}
			if (!string.IsNullOrEmpty(hangSel))
			{
				extra += "&hang=" + HttpUtility.UrlEncode(hangSel);
			}
			string idx = Url.Action("Index", "AuraStore");
			string hash = "#danh-sach";
		}
		<div class="sort-bar" id="danh-sach">
			<span class="lbl">@sapXepTheo</span>
			<a class="sort-btn @(sxSel == "km" ? "on" : "")" href="@(idx + "?sapxep=km" + extra + hash)">@("Khuy\u1ebfn m\u00e3i t\u1ed1t nh\u1ea5t")</a>
			<a class="sort-btn @(sxSel == "gia-asc" || string.IsNullOrEmpty(sxSel) ? "on" : "")" href="@(idx + "?sapxep=gia-asc" + extra + hash)"><i class="fa fa-line-chart"></i> @("Gi\u00e1 t\u0103ng d\u1ea7n")</a>
			<a class="sort-btn @(sxSel == "gia-desc" ? "on" : "")" href="@(idx + "?sapxep=gia-desc" + extra + hash)"><i class="fa fa-area-chart"></i> @("Gi\u00e1 gi\u1ea3m d\u1ea7n")</a>
			<a class="sort-btn @(sxSel == "moi" ? "on" : "")" href="@(idx + "?sapxep=moi" + extra + hash)">@("S\u1ea3n ph\u1ea9m m\u1edbi nh\u1ea5t") <span class="sort-new">NEW</span></a>
			<a class="sort-btn @(sxSel == "ban-chay" ? "on" : "")" href="@(idx + "?sapxep=ban-chay" + extra + hash)"><i class="fa fa-fire sort-hot"></i> @("S\u1ea3n ph\u1ea9m b\u00e1n ch\u1ea1y nh\u1ea5t")</a>
		</div>
		<div class="row">
			@foreach (var item in Model)
			{
				<div class="col-lg-3 col-md-4 col-6" style="margin-bottom:16px">
					@Html.Partial("~/Views/Shared/_LaptopCard.cshtml", item)
				</div>
			}
		</div>
	</div>
</section>
@Html.Action("Newdproducts", "AuraStore")
