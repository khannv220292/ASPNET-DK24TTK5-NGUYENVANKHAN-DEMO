@model IEnumerable<ProTechTiveGear.Models.Banner>
@using System.Collections.Generic
@{
	var slides = new List<string>();
	if (Model != null)
	{
		foreach (var item in Model)
		{
			if (!string.IsNullOrWhiteSpace(item.Picture) && !slides.Contains(item.Picture))
			{
				slides.Add(item.Picture.Trim());
			}
		}
	}
	if (slides.Count == 1)
	{
		slides.Add(slides[0]);
	}
}
@for (var i = 0; i < slides.Count; i++)
{
	<div class="item hb-slide">
		<img src="@Url.Content("~/img/Item/" + slides[i])" alt="Banner @(i + 1)" />
	</div>
}
