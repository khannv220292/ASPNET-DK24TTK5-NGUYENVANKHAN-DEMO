@model IEnumerable<ProTechTiveGear.Models.Item>
@{
    ViewBag.Title = ViewBag.TitleList ?? "Danh sách Laptop";
    ViewBag.HideBanner = true;
    Layout = "~/Views/Shared/_LayoutHomePage.cshtml";
}

<style>
    .tt-page { background: #f5f6f8; padding: 20px 0 48px; min-height: 70vh; }
    .tt-page-title { font-size: 22px; font-weight: 700; margin: 0 0 8px; color: #1a1a1a; }
    .tt-page-sub { color: #666; margin-bottom: 16px; }
    .tt-grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin: 20px 0 40px;
        padding: 0;
    }
    @@media (max-width: 1200px) { .tt-grid-container { grid-template-columns: repeat(4, 1fr); } }
    @@media (max-width: 992px) { .tt-grid-container { grid-template-columns: repeat(3, 1fr); } }
    @@media (max-width: 768px) { .tt-grid-container { grid-template-columns: repeat(2, 1fr); } }

    .tt-product-card {
        background: #ffffff;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        transition: all 0.25s ease-in-out;
        min-height: 380px;
    }
    .tt-product-card:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        border-color: #dbe4f0;
        transform: translateY(-2px);
    }
    .tt-badge-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .tt-tag-vat {
        background: #e30019;
        color: #fff;
        font-size: 10px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .tt-cart-btn-mini {
        width: 26px;
        height: 26px;
        background: #e30019;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff !important;
        text-decoration: none;
        font-size: 14px;
        line-height: 1;
        flex-shrink: 0;
    }
    .tt-cart-btn-mini:hover { background: #c20015; transform: scale(1.1); color: #fff !important; }
    .tt-image-wrap {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 5px 0 12px;
    }
    .tt-image-wrap img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }
    .tt-product-card:hover .tt-image-wrap img { transform: scale(1.04); }
    .tt-title {
        font-size: 13.5px;
        font-weight: 500;
        line-height: 1.4;
        color: #2b2b2b;
        height: 38px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
        margin-bottom: 8px;
        text-decoration: none;
    }
    .tt-title:hover { color: #0088cc; text-decoration: none; }
    .tt-price-current {
        color: #0088cc;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 2px;
    }
    .tt-price-old-wrap {
        font-size: 12px;
        color: #8c8c8c;
        margin-bottom: 12px;
    }
    .tt-price-old { text-decoration: line-through; margin-right: 4px; }
    .tt-discount-rate { color: #0088cc; font-weight: 500; }
    .tt-compare-link {
        font-size: 12.5px;
        color: #0088cc;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-top: 1px dashed #f0f0f0;
        padding-top: 8px;
        margin-top: auto;
    }
    .tt-compare-link:hover { text-decoration: underline; color: #006699; }
    .navbar, .main-menu, ul.nav { position: relative; z-index: 9999 !important; }
</style>

<section class="tt-page">
<div class="container">
    <h2 class="tt-page-title">@(ViewBag.TitleList ?? "Danh sách Laptop")</h2>
    <p class="tt-page-sub">Laptop chính hãng — lưới 5 cột theo mẫu cửa hàng</p>
    <div class="tt-grid-container">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                decimal oldPrice = item.SellPrice * 1.15m;
                var pic = string.IsNullOrWhiteSpace(item.Picture) ? "" : System.IO.Path.GetFileName(item.Picture.Replace("\\", "/"));
                var imgSrc = "https://placehold.co/240x160?text=Laptop";
                var imgFallback = imgSrc;
                if (!string.IsNullOrEmpty(pic))
                {
                    var pItem = Server.MapPath("~/img/Item/" + pic);
                    var pRoot = Server.MapPath("~/img/" + pic);
                    if (System.IO.File.Exists(pItem))
                    {
                        imgSrc = Url.Content("~/img/Item/" + pic);
                        imgFallback = Url.Content("~/img/" + pic);
                    }
                    else if (System.IO.File.Exists(pRoot))
                    {
                        imgSrc = Url.Content("~/img/" + pic);
                        imgFallback = Url.Content("~/img/Item/" + pic);
                    }
                    else
                    {
                        imgSrc = Url.Content("~/img/Item/" + pic);
                        imgFallback = Url.Content("~/img/" + pic);
                    }
                }

                <div class="tt-product-card">
                    <div>
                        <div class="tt-badge-row">
                            <span class="tt-tag-vat">Sản phẩm Full VAT</span>
                            <a href="@Url.Action("AddtoCart", "ShopCart", new { id = item.ID, strURL = Request.Url.ToString() })"
                               class="tt-cart-btn-mini" title="Thêm vào giỏ hàng">+</a>
                        </div>
                        <div class="tt-image-wrap">
                            <a href="@Url.Action("Detail", "AuraStore", new { id = item.ID })">
                                <img src="@imgSrc" alt="@item.Name"
                                     onerror="this.onerror=function(){this.onerror=null;this.src='https://placehold.co/240x160?text=Laptop';};this.src='@imgFallback';" />
                            </a>
                        </div>
                        <a href="@Url.Action("Detail", "AuraStore", new { id = item.ID })"
                           class="tt-title" title="@item.Name">@item.Name</a>
                    </div>
                    <div>
                        <div class="tt-price-current">@string.Format("{0:#,##0}đ", item.SellPrice)</div>
                        <div class="tt-price-old-wrap">
                            <span class="tt-price-old">@string.Format("{0:#,##0}đ", oldPrice)</span>
                            <span class="tt-discount-rate">Giảm 15%</span>
                        </div>
                        <a href="@Url.Action("Detail", "AuraStore", new { id = item.ID })" class="tt-compare-link">
                            <span style="border: 1px solid #0088cc; border-radius: 50%; width: 14px; height: 14px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; line-height: 1;">+</span>
                            Thêm vào so sánh
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; padding: 40px; text-align: center; background: #fff; border-radius: 8px;">
                <p class="text-muted">Không có sản phẩm nào thuộc danh mục này.</p>
            </div>
        }
    </div>
</div>
</section>
