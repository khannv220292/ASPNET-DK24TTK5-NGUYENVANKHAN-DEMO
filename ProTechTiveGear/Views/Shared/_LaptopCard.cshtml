@model ProTechTiveGear.Models.Item
@{
	var info = ProTechTiveGear.Models.LaptopCardInfo.From(Model);
	var pic = string.IsNullOrWhiteSpace(Model.Picture) ? "" : System.IO.Path.GetFileName(Model.Picture.Replace("\\", "/"));
	var imgSrc = "https://placehold.co/320x200?text=" + Uri.EscapeDataString(info.Brand);
	var imgFallback = imgSrc;
	if (!string.IsNullOrEmpty(pic))
	{
		var pItem = Server.MapPath("~/img/Item/" + pic);
		var pRoot = Server.MapPath("~/img/" + pic);
		if (System.IO.File.Exists(pItem))
		{
			imgSrc = Url.Content("~/img/Item/" + pic);
			imgFallback = Url.Content("~/img/" + pic);
		}
		else if (System.IO.File.Exists(pRoot))
		{
			imgSrc = Url.Content("~/img/" + pic);
			imgFallback = Url.Content("~/img/Item/" + pic);
		}
		else
		{
			imgSrc = Url.Content("~/img/Item/" + pic);
			imgFallback = "https://placehold.co/320x200?text=" + Uri.EscapeDataString(info.Brand);
		}
	}
}
<article class="lp-card">
	<div class="lp-media">
		@if (info.DiscountPercent > 0)
		{
			<span class="lp-sale">Giảm @info.DiscountPercent%</span>
		}
		<span class="lp-mark">@info.Brand</span>
		<a href="@Url.Action("Detail", "AuraStore", new { id = Model.ID })">
			<img src="@imgSrc" alt=""
				 onerror="this.onerror=null;this.src='@imgFallback';" />
		</a>
	</div>
	@if (info.IsHot)
	{
		<span class="lp-hot">Bán chạy nhất</span>
	}
	<a class="lp-name" href="@Url.Action("Detail", "AuraStore", new { id = Model.ID })" title="@Model.Name">@Model.Name</a>
	<div class="lp-prices">
		<span class="lp-now">@string.Format("{0:#,##0}₫", Model.SellPrice)</span>
		@if (info.OldPrice > Model.SellPrice)
		{
			<span class="lp-old">@string.Format("{0:#,##0}₫", info.OldPrice)</span>
		}
	</div>
	<a class="lp-compare" href="@Url.Action("Detail", "AuraStore", new { id = Model.ID })"><i></i> So sánh</a>
	<div class="lp-specs">
		<div class="lp-spec" title="@info.Cpu">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"/></svg>
			<span>@info.Cpu</span>
		</div>
		<div class="lp-spec" title="@info.Ram">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="8" rx="1"/><path d="M7 8V6M11 8V6M15 8V6M7 16v2M11 16v2M15 16v2"/></svg>
			<span>@info.Ram</span>
		</div>
		<div class="lp-spec" title="@info.Storage">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="6" width="16" height="12" rx="1"/><path d="M8 18v2M16 18v2M8 6V4M16 6V4"/></svg>
			<span>@info.Storage</span>
		</div>
		<div class="lp-spec" title="@info.Gpu">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 17v2M17 17v2"/></svg>
			<span>@info.Gpu</span>
		</div>
		<div class="lp-spec wide" title="@info.Display">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 20h8M12 16v4"/></svg>
			<span>@info.Display</span>
		</div>
	</div>
	@if (Model.Quantity == 0)
	{
		<span class="lp-cart disabled">Hết hàng</span>
	}
	else
	{
		<a class="lp-cart" href="@Url.Action("AddtoCart", "ShopCart", new { id = Model.ID, strURL = Request.Url.ToString() })">Thêm vào giỏ</a>
	}
</article>
