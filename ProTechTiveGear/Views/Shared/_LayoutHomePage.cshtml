	<script>
		(function ($) {
			var $b = $('#homeBannerOwl');
			if (!$b.length) return;

			function fitBannerHeight() {
				var $img = $b.find('.owl-item.active img').first();
				if (!$img.length) $img = $b.find('.owl-item img').first();
				if (!$img.length || !$img[0].naturalWidth) return;
				// Chiều cao theo tỷ lệ ảnh thật (tránh bị clip / khung trống)
				var w = $b.width() || $img.width();
				var h = Math.round(w * ($img[0].naturalHeight / $img[0].naturalWidth));
				if (!h) return;
				$b.find('.owl-stage-outer, .owl-stage, .owl-item.active').css({ height: h + 'px' });
				$b.find('.owl-stage-outer').css('overflow', 'hidden');
				$b.css({ height: h + 'px', overflow: 'hidden' });
			}

			if (!$b.hasClass('owl-loaded') && $.fn.owlCarousel) {
				$b.owlCarousel({
					items: 1,
					loop: true,
					autoplay: true,
					autoplayTimeout: 4000,
					autoplayHoverPause: true,
					nav: true,
					dots: true,
					autoHeight: false,
					smartSpeed: 700,
					navText: ['<i class="fa fa-angle-left"></i>', '<i class="fa fa-angle-right"></i>']
				});
			}

			$b.on('initialized.owl.carousel resized.owl.carousel changed.owl.carousel translated.owl.carousel', function () {
				fitBannerHeight();
				setTimeout(fitBannerHeight, 50);
			});
			$b.find('img').on('load', fitBannerHeight);
			setTimeout(fitBannerHeight, 50);
			setTimeout(fitBannerHeight, 300);
			setTimeout(fitBannerHeight, 800);
			$(window).on('resize', fitBannerHeight);
		})(jQuery);
	</script>
