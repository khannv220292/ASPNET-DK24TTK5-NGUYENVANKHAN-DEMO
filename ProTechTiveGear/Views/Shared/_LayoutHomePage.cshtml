	<link href="~/Content/style.css" rel="stylesheet" />
	<link href="~/Content/responsive.css" rel="stylesheet">
	<style>
		.top-strip { background-color: #0b69b7; color: #e6f3ff; font-size: 12px; padding: 5px 0; }
		.top-strip span { margin: 0 10px; }
		.header-custom { background-color: #0077dd; padding: 12px 0; color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
		.header-container { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; }
		.brand-logo { font-size: 22px; font-weight: 800; color: #fff !important; text-decoration: none !important; white-space: nowrap; }
		.brand-logo span { color: #ffe600; }
		.btn-category { background-color: rgba(255,255,255,.2); color: #fff !important; border-radius: 20px; padding: 8px 16px; font-size: 13px; font-weight: 600; text-decoration: none !important; white-space: nowrap; }
		.btn-category:hover { background-color: rgba(255,255,255,.3); color: #fff !important; }
		.search-wrapper { flex-grow: 1; max-width: 420px; position: relative; min-width: 200px; }
		.search-input { width: 100%; height: 38px; border-radius: 20px; border: none; padding: 0 45px 0 16px; font-size: 13px; color: #333; }
		.search-btn { position: absolute; right: 4px; top: 3px; width: 32px; height: 32px; border-radius: 50%; border: none; background: transparent; color: #0077dd; cursor: pointer; }
		.header-action-item { display: inline-flex; align-items: center; gap: 8px; color: #fff !important; text-decoration: none !important; font-size: 13px; white-space: nowrap; }
		.header-action-text b { display: block; font-size: 14px; color: #fff; }
		.main_header_three { position: relative !important; top: auto !important; background: #0077dd; z-index: 40; }
		.main_header_three + section, .main_header_three + div { margin-top: 0 !important; }
		.main_header_three.navbar_fixed .middle_menu_three {
			position: relative !important;
			top: auto !important;
			transform: none !important;
			box-shadow: none;
		}
		.middle_menu_three { background: #fff; position: relative; z-index: 1; }
		.middle_menu_three .navbar { padding-left: 0; padding-right: 0; }
		.middle_menu_three .navbar-brand { display: none; }
		.pv-wrap { padding-top: 32px !important; }
		.pv-head { background: #fff; border-radius: 8px; padding: 16px 20px; margin: 0 0 22px; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
		.pv-img { overflow: hidden; }
		.cake_feature_main .main_title, .new_arivals_area .single_pest_title { text-align: left; }
	</style>

	<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
	<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
