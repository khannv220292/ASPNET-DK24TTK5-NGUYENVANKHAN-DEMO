					</div>
					<div class="col-lg-3 col-6">
						<aside class="f_widget f_contact_widget">
							<div class="f_title">
								<h3>Liên hệ</h3>
							</div>
                            <h4>Phone: 0978.111.017</h4>
                            <h5>Địa chỉ: 369 An Dương Vương, Phường Bình Phú, TP.Hồ Chí Minh</h5>
                            <h5>khannv220292@tvu-onschool.edu.vn</h5>
						</aside>
					</div>
				</div>
			</div>
		</div>
		
	</footer>
