	<![endif]-->

	<script>$.removeCookie('the_cookie', { path: '/' });</script>
</head>
<body>

	<!--================Main Header Area =================-->
	<header class="main_header_three">
		<div class="top-strip">
			<div class="container text-center">
				<span>Giá rẻ dẫn đầu - Bảo hành siêu lâu</span>
				<span>&bull;</span>
				<span>Thu cũ giá tốt - Lên đời tiết kiệm</span>
				<span>&bull;</span>
				<span>Sản phẩm Chính hãng - VAT đầy đủ</span>
			</div>
		</div>
		<div class="header-custom">
			<div class="container">
				<div class="header-container">
					<a href="@Url.Action("Index", "AuraStore")" class="brand-logo">laptop.<span>khannv</span>.vn</a>
					<a href="@Url.Action("Index", "AuraStore")" class="btn-category"><i class="fa fa-th-list"></i> Danh mục</a>
					<div class="search-wrapper">
						@using (Html.BeginForm("Index", "AuraStore", FormMethod.Get))
						{
							<input type="text" name="search" class="search-input" placeholder="Nhập tên laptop cần tìm..." value="@Request.QueryString["search"]" />
							<button type="submit" class="search-btn"><i class="fa fa-search"></i></button>
						}
					</div>
					<div class="header-action-item">
						<i class="fa fa-phone"></i>
						<div class="header-action-text">
							<span style="font-size:11px;opacity:.9">Hotline CSKH</span>
							<b>0978.111.017</b>
						</div>
					</div>
					<a href="@Url.Action("Cart", "ShopCart")" class="header-action-item">
						<i class="fa fa-shopping-cart"></i>
						<span>Giỏ hàng</span>
					</a>
					<a href="@Url.Action("Login", "Admin")" class="header-action-item">
						<i class="fa fa-cog"></i>
						<span>Admin</span>
					</a>
					@if (Session["usr"] == null)
					{
						<a href="@Url.Action("Login", "Login")" class="header-action-item">
							<i class="fa fa-user"></i>
							<span>Đăng nhập</span>
						</a>
					}
					else
					{
						<a href="@Url.Action("Profile", "AuraStore")" class="header-action-item">
							<i class="fa fa-user"></i>
							<span>@(acc != null ? acc.Name : "Tài khoản")</span>
						</a>
					}
				</div>
			</div>
		</div>
		<div class="middle_menu_three">
			<div class="container">
				<nav class="navbar navbar-expand-lg navbar-light bg-light">
					<a class="navbar-brand" href="index.html"><img src="img/logo-2.png" alt=""></a>
					<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
						<span class="my_toggle_menu">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</button>




					@Html.Action("Menu", "AuraStore")



				</nav>
			</div>
		</div>
	</header>
	<!--================End Main Header Area =================-->
	@if (ViewBag.HideBanner != true)
	{
	<section class="main_slider_area">
		<div id="main_slider" class="rev_slider" data-version="5.3.1.6">
			<ul>
				@Html.Action("Banner", "AuraStore")
			</ul>
		</div>
	</section>
	}
	<!--================Welcome Area =================-->
	@RenderBody()

	<!--================End Welcome Area =================-->
	<!--================Service We offer Area =================-->
