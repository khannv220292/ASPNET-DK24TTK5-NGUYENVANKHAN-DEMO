<style>
	.lp-card { --c:#e67e22; background:#fff; border:1px solid #eee; border-radius:12px; padding:12px; height:100%; display:flex; flex-direction:column; box-shadow:0 2px 10px rgba(0,0,0,.05); }
	.lp-top { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; margin-bottom:6px; min-height:28px; }
	.lp-badge { font-size:11px; font-weight:700; color:var(--c); border:1px solid var(--c); padding:3px 8px; border-radius:12px; max-width:70%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
	.lp-off { background:var(--c); color:#fff; font-size:12px; font-weight:700; padding:3px 7px; border-radius:4px; flex-shrink:0; }
	.lp-img { height:150px; display:flex; align-items:center; justify-content:center; margin:4px 0 8px; }
	.lp-img img { max-height:145px; max-width:100%; object-fit:contain; }
	.lp-name { font-size:14px; font-weight:800; color:#111; min-height:40px; margin:0 0 4px; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
	.lp-name a { color:#111; }
	.lp-sub { font-size:12px; color:#888; min-height:18px; margin-bottom:8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
	.lp-specs { display:flex; background:#f4f7fb; border-radius:8px; padding:8px 4px; margin-bottom:10px; text-align:center; }
	.lp-specs > div { flex:1 1 0; min-width:0; padding:0 3px; font-size:11px; color:#445; }
	.lp-specs i { display:block; margin-bottom:4px; color:#556; }
	.lp-specs b { display:block; font-size:11px; line-height:1.25; height:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:#123; font-weight:700; }
	.lp-price { color:#e67e22; font-size:20px; font-weight:800; }
	.lp-old { color:#9aa; font-size:12px; text-decoration:line-through; margin-left:6px; }
	.lp-stock { color:#2e7d32; font-size:13px; font-weight:600; margin:8px 0; display:flex; align-items:center; gap:6px; }
	.lp-dot { width:8px; height:8px; border-radius:50%; background:#2e7d32; display:inline-block; }
	.lp-stock.out { color:#c0392b; }
	.lp-stock.out .lp-dot { background:#c0392b; }
	.lp-btns { display:flex; gap:8px; margin-top:auto; }
	.lp-btns a, .lp-btns span { flex:1; text-align:center; padding:8px 4px; border-radius:8px; font-size:12px; font-weight:700; }
	.lp-cart { border:1px solid var(--c); color:var(--c); background:#fff; }
	.lp-cart:hover { background:var(--c); color:#fff; text-decoration:none; }
	.lp-more { background:var(--c); color:#fff !important; }
	.lp-more:hover { opacity:.92; text-decoration:none; color:#fff; }
	.sort-bar { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:22px; }
	.sort-bar .lbl { font-weight:800; font-size:16px; color:#222; margin-right:4px; }
	.sort-btn { display:inline-flex; align-items:center; gap:6px; border:1px solid #d0d5dd; background:#fff; color:#222; border-radius:8px; padding:8px 12px; font-size:13px; font-weight:600; text-decoration:none; }
	.sort-btn:hover { border-color:#e67e22; color:#e67e22; text-decoration:none; }
	.sort-btn.on { border-color:#e67e22; color:#e67e22; box-shadow:0 0 0 1px #e67e22; }
	.sort-new { background:#1e88e5; color:#fff; font-size:10px; font-weight:800; padding:1px 5px; border-radius:3px; }
	.sort-hot { color:#e53935; }
</style>
