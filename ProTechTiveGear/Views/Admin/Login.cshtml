@model ProTechTiveGear.Models.AccountAdminEntity
@{
	ViewBag.Title = "Dangnhap";
	Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

@using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { @class = "login100-form validate-form wrap-login100" }))
{
	@Html.AntiForgeryToken()
	<span class="login100-form-logo">
		<i class="zmdi zmdi-landscape"></i>
	</span>
	<span class="login100-form-title p-b-34 p-t-27">
		Đăng nhập Admin
	</span>
	<div class="wrap-input100 validate-input" data-validate="Enter username">
		<input class="input100" type="text" name="userName" id="userName" placeholder="Tài khoản" value="Admin" />
		<span class="focus-input100" data-placeholder="&#xf207;"></span>
	</div>
	<div class="wrap-input100 validate-input" data-validate="Enter password">
		<input class="input100" type="password" name="passWord" id="passWord" placeholder="Mật khẩu" />
		<span class="focus-input100" data-placeholder="&#xf191;"></span>
		<span style="color:red">@Html.ValidationSummary(true)</span>
	</div>
	<div class="container-login100-form-btn">
		<button type="submit" class="login100-form-btn">Đăng Nhập</button>
	</div>
}
