@model IEnumerable<LaptopStore.Models.StoreItem>
@{
    ViewBag.Title = "Báo cáo sản phẩm chưa bán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>BÁO CÁO THỐNG KÊ: SẢN PHẨM TỒN KHO CHƯA PHÁT SINH ĐƠN HÀNG (Productnotsold)</h2>
<p class="text-muted">Truy vấn các mặt hàng chưa từng xuất hiện trong chi tiết đơn hàng (OrderDetail).</p>

<table class="table table-bordered table-striped table-hover">
    <thead>
        <tr class="info">
            <th>Mã ID</th>
            <th>Tên sản phẩm</th>
            <th>Hãng / tình trạng</th>
            <th>Giá nhập</th>
            <th>Giá bán</th>
            <th>Tồn kho</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Name</td>
                <td>@(item.Brand != null ? item.Brand.Name : "")</td>
                <td>@string.Format("{0:#,##0}đ", item.PurcharsePrice)</td>
                <td>@string.Format("{0:#,##0}đ", item.SellPrice)</td>
                <td>@item.Quantity máy</td>
            </tr>
        }
    </tbody>
</table>
