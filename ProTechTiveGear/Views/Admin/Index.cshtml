@model IEnumerable<LaptopStore.Models.StoreItem>
@{
	ViewBag.Title = "Quản lý laptop";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="card shadow mb-4">
	<div class="card-header py-3">
		<h4>Danh sách laptop</h4>
		@Html.ActionLink("Thêm mới", "Create", "Admin", null, new { @class = "btn btn-success btn-sm" })
		@Html.ActionLink("Hàng chưa bán", "Productnotsold", "Admin", null, new { @class = "btn btn-info btn-sm" })
	</div>
	<div class="card-body">
		<table class="table table-bordered table-hover">
			<thead>
				<tr>
					<th>Ảnh</th>
					<th>Tên</th>
					<th>Giá bán</th>
					<th>Tồn</th>
					<th>Hãng</th>
					<th>Loại</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td><img width="70" src="~/img/Item/@item.Picture" alt="" /></td>
						<td>@item.Name</td>
						<td>@string.Format("{0:N0}", item.SellPrice)</td>
						<td>@item.Quantity</td>
						<td>@(item.Brand != null ? item.Brand.Name : "")</td>
						<td>@(item.ItemType != null ? item.ItemType.TypeName : "")</td>
						<td>
							@Html.ActionLink("Sửa", "Edit", new { id = item.ID }) |
							@Html.ActionLink("Xóa", "Delete", new { id = item.ID })
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
