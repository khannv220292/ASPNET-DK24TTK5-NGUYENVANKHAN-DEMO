@model LaptopStore.Models.StoreItem
@{
	ViewBag.Title = "Sửa laptop";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
	var img = string.IsNullOrWhiteSpace(Model.Picture)
		? "https://placehold.co/200x140?text=Laptop"
		: Url.Content("~/img/Item/" + Model.Picture);
}
<h3>Sửa laptop</h3>
@using (Html.BeginForm("Edit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
	@Html.AntiForgeryToken()
	@Html.HiddenFor(m => m.ID)
	@Html.HiddenFor(m => m.Active)
	@Html.HiddenFor(m => m.DateImport)
	@Html.ValidationSummary(true, "", new { @class = "text-danger" })
	<div class="form-group">@Html.LabelFor(m => m.Name) @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })</div>
	<div class="form-group">@Html.LabelFor(m => m.PurcharsePrice) @Html.EditorFor(m => m.PurcharsePrice, new { htmlAttributes = new { @class = "form-control" } })</div>
	<div class="form-group">@Html.LabelFor(m => m.SellPrice) @Html.EditorFor(m => m.SellPrice, new { htmlAttributes = new { @class = "form-control" } })</div>
	<div class="form-group">@Html.LabelFor(m => m.Quantity) @Html.EditorFor(m => m.Quantity, new { htmlAttributes = new { @class = "form-control" } })</div>
	<div class="form-group">@Html.DropDownList("TypeID", null, new { @class = "form-control" })</div>
	<div class="form-group">@Html.DropDownList("BrandID", null, new { @class = "form-control" })</div>
	<div class="form-group">
		<label>Hình ảnh</label>
		@Html.HiddenFor(m => m.Picture)
		<input type="file" name="photo" id="photo" accept="image/*" class="form-control" />
		<p class="text-muted small">Chọn ảnh mới từ máy (để trống nếu giữ ảnh cũ).</p>
		<img id="preview" src="@img" alt="preview" style="max-height:140px;margin-top:8px;"
			 onerror="this.onerror=null;this.src='https://placehold.co/200x140?text=Laptop';" />
	</div>
	<div class="form-group">@Html.LabelFor(m => m.Describe) @Html.TextAreaFor(m => m.Describe, new { @class = "form-control", rows = 4 })</div>
	<button type="submit" class="btn btn-success">Cập nhật</button>
	@Html.ActionLink("Quay lại", "Index")
}
@section upload {
<script>
	document.getElementById('photo').addEventListener('change', function (e) {
		if (e.target.files && e.target.files[0]) {
			document.getElementById('preview').src = URL.createObjectURL(e.target.files[0]);
		}
	});
</script>
}
